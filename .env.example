# Shared frontend / backend environment template for Meal.OS

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend app identity
APP_NAME=Meal.OS
APP_VERSION=0.1.0
DEBUG=true

# Backend runtime
DATABASE_URL=sqlite:///./meal_os.db
AUTO_SEED=false

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
